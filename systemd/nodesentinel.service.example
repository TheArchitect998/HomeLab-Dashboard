[Unit]
Description=NodeSentinel dashboard service
After=network-online.target
Wants=network-online.target

[Service]
User=user
WorkingDirectory=/opt/nodesentinel
EnvironmentFile=/opt/nodesentinel/.env
ExecStart=/opt/nodesentinel/bin/nodesentinel dashboard
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
