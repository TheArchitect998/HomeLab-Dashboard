[Unit]
Description=NodeSentinel dashboard service
After=network-online.target
Wants=network-online.target

[Service]
User=user
WorkingDirectory=/opt/nodesentinel
EnvironmentFile=/opt/nodesentinel/.env
ExecStart=/opt/nodesentinel/venv/bin/uvicorn dashboard_api:app --host 0.0.0.0 --port 8888
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
