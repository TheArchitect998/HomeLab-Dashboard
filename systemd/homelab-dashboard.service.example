[Unit]
Description=HomeLab dashboard service
After=network-online.target
Wants=network-online.target

[Service]
User=savpiu
WorkingDirectory=/opt/homelab-dashboard
EnvironmentFile=-/etc/environment
ExecStart=/opt/homelab-dashboard/venv/bin/uvicorn dashboard_api:app --host 0.0.0.0 --port 8888
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
