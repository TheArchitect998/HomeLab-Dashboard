[Unit]
Description=NodeSentinel metrics agent
After=network-online.target
Wants=network-online.target

[Service]
User=user
EnvironmentFile=-/etc/nodesentinel-agent.env
WorkingDirectory=/opt/nodesentinel
ExecStart=/opt/nodesentinel/bin/nodesentinel agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
