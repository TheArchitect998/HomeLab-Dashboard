# Mindestens 16 Zeichen; z. B. erzeugen mit: openssl rand -base64 32
# Der Agent startet nicht mit leerem, kurzem oder diesem Beispielwert.
NODESENTINEL_AGENT_KEY=change-me
# Optional HTTPS (Zertifikat/Schlüssel müssen für den Agent-Benutzer lesbar sein):
# NODESENTINEL_AGENT_TLS_CERTFILE=/etc/nodesentinel-agent/agent.crt
# NODESENTINEL_AGENT_TLS_KEYFILE=/etc/nodesentinel-agent/agent.key
