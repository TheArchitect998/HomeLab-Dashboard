# Mindestens 16 Zeichen; z. B. erzeugen mit: openssl rand -base64 32
# Der Agent startet nicht mit leerem, kurzem oder diesem Beispielwert.
NODESENTINEL_AGENT_KEY=change-me
NODESENTINEL_AGENT_NAME=HomeLab1
NODESENTINEL_HUB_URL=wss://dashboard.example
# Optional CA certificate for a private dashboard CA:
# NODESENTINEL_HUB_CA_CERT=/etc/nodesentinel-agent/hub-ca.crt
# NODESENTINEL_AGENT_PUSH_SECONDS=15
# Optional sensitive sources; grant the corresponding permissions separately.
# NODESENTINEL_ENABLE_DOCKER=1
# NODESENTINEL_ENABLE_JOURNAL=1
# NODESENTINEL_ENABLE_UFW=1
# NODESENTINEL_ENABLE_FAIL2BAN=1
# NODESENTINEL_ENABLE_SMART=1
