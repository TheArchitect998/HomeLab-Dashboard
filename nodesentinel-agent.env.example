# Mindestens 16 Zeichen, zufällig erzeugen: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Der Agent startet nicht mit leerem, kurzem oder diesem Beispielwert.
NODESENTINEL_AGENT_KEY=change-me
# Optional HTTPS (Zertifikat/Schlüssel müssen für den Agent-Benutzer lesbar sein):
# UVICORN_SSL_CERTFILE=/etc/nodesentinel-agent/agent.crt
# UVICORN_SSL_KEYFILE=/etc/nodesentinel-agent/agent.key
