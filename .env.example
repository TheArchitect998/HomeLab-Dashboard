NODESENTINEL_DASHBOARD_HOST=0.0.0.0
NODESENTINEL_DASHBOARD_PORT=8888
# Optional reverse proxy source IP/CIDR (required to trust X-Forwarded-Proto)
# NODESENTINEL_TRUSTED_PROXIES=127.0.0.1,192.168.1.10
AGENT_URLS='["http://pi-1.local:9100/api/metrics","http://pi-2.local:9100/api/metrics"]'
AGENT_KEY=change-me
# Optional: CA/Zertifikat zur Prüfung von HTTPS-Agenten mit selbst signiertem Zertifikat
# AGENT_CA_CERT=/opt/nodesentinel/certs/agent.crt
NODESENTINEL_STATE_DIR=/opt/nodesentinel/state
# NODESENTINEL_DASHBOARD_IMAGE=thearchitect998/nodesentinel:latest
# NODESENTINEL_AGENT_IMAGE=thearchitect998/nodesentinel-agent:latest
