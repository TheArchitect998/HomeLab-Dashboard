FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOMELAB_AGENT_CONTAINER=1

WORKDIR /opt/homelab-agent
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker-cli systemd ufw fail2ban smartmontools \
    && rm -rf /var/lib/apt/lists/*
COPY backend/requirements-agent.txt .
RUN pip install --no-cache-dir -r requirements-agent.txt
COPY backend/agent.py .

EXPOSE 9100
CMD ["uvicorn", "agent:app", "--host", "0.0.0.0", "--port", "9100"]
