FROM golang:1.27-bookworm AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/nodesentinel ./cmd/nodesentinel

FROM debian:bookworm-slim

ENV NODESENTINEL_AGENT_CONTAINER=1 \
    HOST_PROC=/host/proc

WORKDIR /opt/nodesentinel-agent
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates docker.io systemd ufw fail2ban smartmontools iputils-ping \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /out/nodesentinel /usr/local/bin/nodesentinel

EXPOSE 9100
CMD ["/usr/local/bin/nodesentinel", "agent"]
